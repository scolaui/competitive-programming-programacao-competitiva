#include <bits/stdc++.h>
using namespace std;

long long findLectures(vector<pair<long long, long long>>& arr){
    sort(arr.begin(), arr.end(), [](auto &a, auto &b){
        return a.second < b.second;
    });
    
    long long lec = 0;
    long long lastLec = -1;
    
    for (int i = 0; i < arr.size(); i++){
        if (arr[i].first >= lastLec){
            lec++;
            lastLec = arr[i].second;
        }
    }
    
    return lec;
}

int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    long long n;
    cin >> n;
    
    vector<pair<long long, long long>> arr (n);
    for (int i = 0; i < n; i++){
        cin >> arr[i].first >> arr[i].second;
    }
    
    cout << findLectures(arr);
    
    return 0;
}
