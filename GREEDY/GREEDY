#include <bits/stdc++.h>

using namespace std;

int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int t;
    cin >> t;

    while (t > 0){
        int sum = 0;
        vector<int> arr(7);
        for (int i = 0; i < 7; i++){
            cin >> arr[i];
        }

        sort(arr.begin(), arr.end());

        for (int i = 0; i < 7; i++){
            if (i < 6){
                arr[i] *= -1;
            }
            sum += arr[i];
        }
        cout << sum << "\n";
        t--;
    }

    return 0;
}
