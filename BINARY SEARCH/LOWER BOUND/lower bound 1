#include <bits/stdc++.h>

using namespace std;

long long findX(vector<long long>& arr, long long n, long long x, long long esq, long long dir){
    long long first = -1;
    while (esq <= dir){
        long long h = (dir + esq)/2;
        
        if (arr[h] == x){
            first = h;
            dir = h-1;
        } else if (arr[h] > x){
            dir = h-1;
        } else{
            esq = h+1;
        }
    }
    
    return first;
}

int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    long long n, x;
    cin >> n >> x;
    
    long long esq = 1;
    long long dir = n;
    
    vector<long long> arr(n+1, 0);
    for (int i = 1; i <= n; i++){
        cin >> arr[i];
    }
    sort(arr.begin(), arr.end());
    
    cout << findX(arr, n, x, esq, dir);
    
    return 0;
}
