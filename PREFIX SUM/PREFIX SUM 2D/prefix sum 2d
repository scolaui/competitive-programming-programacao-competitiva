#include <bits/stdc++.h>
#define int long long
using namespace std;

signed main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int n, q;
    cin >> n >> q;
    
    vector<vector<int>> pref(n+1, vector<int> (n+1,0));
    
    for (int r = 1; r <= n; r++){
        string s;
        cin >> s;
        for (int c = 1; c <= n; c++){
            int tree = (s[c-1] == '*' ? 1 : 0);
            
            pref[r][c] = tree
                        + pref[r-1][c]
                        + pref[r][c-1]
                        - pref[r-1][c-1];
        }
    }
    
    while (q--){
        int y1, x1, y2, x2;
        cin >> y1 >> x1 >> y2 >> x2;
        
        int sum = pref[y2][x2]
                - pref[y1-1][x2]
                - pref[y2][x1-1]
                + pref[y1-1][x1-1];
                
        cout << sum << "\n";
    }
    
    return 0;
}
