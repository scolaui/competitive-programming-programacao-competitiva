#include <bits/stdc++.h>
#define int long long
using namespace std;

signed main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    string s;
    int q;
    
    cin >> s;
    cin >> q;
    
    int n = s.length();
    
    vector<int> pref(n+1, 0);
    for (int i = 0; i < s.size(); i++){
        pref[i+1] = pref[i] + (s[i] == 'a' ? 1 : 0);
        
    }
    
    while (q--){
        int l, r;
        cin >> l >> r;
        
        cout << pref[r] - pref[l-1] << "\n";
    }
    
    return 0;
}
